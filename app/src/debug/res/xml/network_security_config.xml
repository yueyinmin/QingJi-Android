<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建生效的网络配置（release 不包含本文件，行为完全不变）。

  为什么需要它：
  单元测试和真实设备都能覆盖 UI 逻辑，唯独「AI 正在流式回复」这个中间态必须连一个
  真的会分片返回的服务才能看到。本地起一个假 OpenAI 兼容服务走的是 http://10.0.2.2，
  而 targetSdk 35 默认禁止明文 HTTP，请求会直接失败，永远抓不到中间态。

  这里只放行模拟器回环地址（10.0.2.2 / localhost），其余域名保持禁止明文。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
