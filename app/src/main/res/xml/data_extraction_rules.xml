<?xml version="1.0" encoding="utf-8"?>
<!--
  阶段 K：Android 12+ 的云备份与换机直传规则。原则同 backup_rules.xml：
  - 只 include database，其它域（sharedpref / file / root / external）不 include
    就等于不备份，不能再写 exclude（lint 会报路径不在 included path 里）；
  - database 里排除 AI 库：聊天原文与长期记忆不进系统备份，也不随换机直传。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <exclude domain="database" path="qingji_ai.db" />
        <exclude domain="database" path="qingji_ai.db-shm" />
        <exclude domain="database" path="qingji_ai.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="database" path="qingji_ai.db" />
        <exclude domain="database" path="qingji_ai.db-shm" />
        <exclude domain="database" path="qingji_ai.db-wal" />
    </device-transfer>
</data-extraction-rules>
